// LALRPOP grammar for the Dolfin ontology language
//
// This grammar handles the indentation-based syntax of Dolfin using
// INDENT/DEDENT/NEWLINE tokens provided by the custom lexer.

use crate::ast::*;
use crate::lexer::Token;
use crate::error::{ErrorCode, LexerError, Location, Span, SpannedString};

grammar;

// ============================================================================
// EXTERN DEFINITIONS
// ============================================================================

extern {
    type Location = Location;
    type Error = LexerError;

    enum Token {
        // Keywords
        "package" => Token::Package,
        "prefix" => Token::Prefix,
        "@iri_name" => Token::IriName,
        "as" => Token::As,
        "concept" => Token::Concept,
        "property" => Token::Property,
        "one of" => Token::OneOf,
        "rule" => Token::Rule,
        "query" => Token::Query,
        "return" => Token::Return,
        "either" => Token::Either,
        "or" => Token::Or,
        "group by" => Token::GroupBy,
        "match" => Token::Match,
        "then" => Token::Then,
        "sub" => Token::Sub,
        "has" => Token::Has,
        "key" => Token::Key,
        "a" => Token::Is,
        "fact" => Token::Fact,
        "is" => Token::IsInverse,
        "^" => Token::Hat,
        "inverse of" => Token::InverseOf,
        "equivalent to" => Token::EquivalentTo,
        "transitive" => Token::Transitive,
        "symmetric" => Token::Symmetric,
        "reflexive" => Token::Reflexive,
        "unitdef" => Token::Unit,
        "family" => Token::Family,
        "nominal" => Token::Nominal,
        "scale" => Token::Scale,

        // Quantifier keywords
        "all" => Token::All,
        "none" => Token::None,
        "at_least" => Token::AtLeast,
        "at_most" => Token::AtMost,
        "exactly" => Token::Exactly,
        "between" => Token::Between,
        "of" => Token::Of,

        // Cardinality keywords
        "one" => Token::One,
        "any" => Token::Any,
        "some" => Token::Some,
        "optional" => Token::Optional,
        
        // Primitive types
        "string" => Token::TString,
        "int" => Token::TInt,
        "float" => Token::TFloat,
        "boolean" => Token::TBoolean,
        "date" => Token::TDate,
        "date_time" => Token::TDateTime,
        "time" => Token::TTime,
        "duration" => Token::TDuration,

        // Literals
        INT => Token::Int(<i64>),
        FLOAT => Token::Float(<f64>),
        STRING => Token::String(<String>),
        BOOLEAN => Token::Boolean(<bool>),
        IRI => Token::Iri(<String>),
        
        // Identifiers
        PREFIXED_NAME => Token::PrefixedName(<(String, String)>),
        NAME => Token::Name(<String>),
        VARIABLE => Token::Variable(<String>),
        TEMPORAL_LIT => Token::TemporalLit(<(TemporalKind, String)>),
        QUANTITY_LIT => Token::QuantityLit(<String>),
        LOCALE_DIRECTIVE => Token::LocaleDirective(<String>),
        TIMEZONE_DIRECTIVE => Token::TimezoneDirective(<String>),
        
        // Punctuation
        ":" => Token::Colon,
        "," => Token::Comma,
        "." => Token::Dot,
        "->" => Token::Arrow,
        ".." => Token::DoubleDot,
        "*" => Token::Star,
        "|" => Token::Pipe,
        "^^" => Token::DoubleCaret,

        // Brackets
        "[" => Token::LBracket,
        "]" => Token::RBracket,

        // Arithmetic operators
        "+" => Token::Plus,
        "-" => Token::Minus,
        "/" => Token::Slash,
        "(" => Token::LParen,
        ")" => Token::RParen,

        // Comparison operators
        "=" => Token::Equal,
        "!=" => Token::NotEqual,
        "<" => Token::LessThan,
        "<=" => Token::LessEqual,
        ">" => Token::GreaterThan,
        ">=" => Token::GreaterEqual,
        
        // Indentation tokens
        INDENT => Token::Indent,
        DEDENT => Token::Dedent,
        NEWLINE => Token::Newline,
        EOF => Token::Eof,
    }
}

// ============================================================================
// MACROS
// ============================================================================

// Comma-separated list with at least one element
Comma<T>: Vec<T> = {
    <first:T> <rest:("," <T>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

// Optional element
Optional<T>: Option<T> = {
    <T> => Some(<>),
    => None,
};

// ============================================================================
// TOP-LEVEL
// ============================================================================

/// An ontology file (the main entry point for .dlf files except package.dlf)
pub OntologyFile: OntologyFile = {
    NEWLINE*
    <start:@L>
    <iri_name:IriNameAnnotation?>
    <items:HeaderItem*>
    // NEWLINE*
    <declarations:Declaration*>
    EOF <end:@R> => {
        // Prefixes and directives may interleave freely; last directive of each
        // kind wins.
        let mut prefixes = Vec::new();
        let mut locale = None;
        let mut timezone = None;
        for item in items {
            match item {
                HeaderItem::Prefixes(p) => prefixes.extend(p),
                HeaderItem::Locale(a) => locale = Some(a),
                HeaderItem::Timezone(a) => timezone = Some(a),
            }
        }
        OntologyFile {
            iri_name,
            prefixes,
            declarations,
            locale,
            timezone,
            span: Some(Span { start, end }),
        }
    },
};


// ============================================================================
// PACKAGE MANIFEST (package.dlf)
// ============================================================================

/// Package definition for package.dlf files
pub PackageFile: PackageFile = {
    <start:@L> "package" <name:QualifiedNameOrIRI> ":" NEWLINE
    INDENT <fields:PackageField+> DEDENT EOF <end:@R>
    => {
        let mut manifest = PackageFile {
            name,
            dolfin_version: String::new(),
            version: String::new(),
            author: None,
            description: None,
            span: Some(Span { start, end }),
        };
        for field in fields {
            match field {
                PackageField::DolfinVersion(v) => manifest.dolfin_version = v,
                PackageField::Version(v) => manifest.version = v,
                PackageField::Author(v) => manifest.author = Some(v),
                PackageField::Description(v) => manifest.description = Some(v),
            }
        }
        manifest
    }
};

PackageField: PackageField = {
    <l:@L> <f:NAME> <r:@R> <v:STRING> NEWLINE =>? {
        match f.as_str() {
            "dolfin_version" => Ok(PackageField::DolfinVersion(v)),
            "version" => Ok(PackageField::Version(v)),
            "author" => Ok(PackageField::Author(v)),
            "description" => Ok(PackageField::Description(v)),
            _ => Err(lalrpop_util::ParseError::UnrecognizedToken {
                token: (l, Token::Name(f), r),
                expected: vec![
                    "dolfin_version".to_string(),
                    "version".to_string(),
                    "author".to_string(),
                    "description".to_string(),
                ],
            }),
        }
    }    
};

// ============================================================================
// PREFIX
// ============================================================================

PrefixStmt: Vec<PrefixDecl> = {
    "prefix" <target:PrefixTarget> => target
};

PrefixTarget: Vec<PrefixDecl> = {
    // Hierarchical prefix: prefix com.example:
    //   Person
    //   Organization as Org
    <prefix:QualifiedName> ":" NEWLINE INDENT <children:PrefixTarget+> DEDENT => {
        children.into_iter()
            .flatten()
            .map(|imp| PrefixDecl {
                path: prefix.join(&imp.path),
                alias: imp.alias,
                span: imp.span,
            })
            .collect()
    },
    // Aliased prefix: prefix com.example.Person as P
    <start:@L> <path:QualifiedNameOrIRI> "as" <alias:NAME> <end:@R> NEWLINE => {
        vec![PrefixDecl { path, alias, span: Some(Span { start, end }) }]
    },
    // Simple prefix: prefix com.example.Person
    <start:@L> <path:QualifiedNameOrIRI> <end:@R> NEWLINE => {
        let alias = path.last().to_string();
        vec![PrefixDecl { path, alias, span: Some(Span { start, end }) }]
    },
};

// ============================================================================
// ANNOTATIONS
// ============================================================================

/// IRI name annotation to override the derived IRI segment or concept IRI
IriNameAnnotation: IriNameValue = {
    "@iri_name" <name:STRING> NEWLINE+ => IriNameValue::LocalSegment(name),
    "@iri_name" <iri:IRI> NEWLINE+ => IriNameValue::AbsoluteUri(iri),
};

/// A file-header item: a prefix statement or a `@locale`/`@timezone` directive.
/// Collecting these in one repetition lets prefixes and directives appear in
/// any order at the top of the file without an LR ambiguity.
HeaderItem: HeaderItem = {
    <p:PrefixStmt> => HeaderItem::Prefixes(p),
    <a:LOCALE_DIRECTIVE> NEWLINE+ => HeaderItem::Locale(a),
    <a:TIMEZONE_DIRECTIVE> NEWLINE+ => HeaderItem::Timezone(a),
};

// ============================================================================
// ONTOLOGY
// ============================================================================

/// Top-level declarations in an ontology file
Declaration: Declaration = {
    <c:ConceptDef> NEWLINE? => Declaration::Concept(c),
    <p:PropertyDef> NEWLINE? => Declaration::Property(p),
    <r:RuleDef> NEWLINE? => Declaration::Rule(r),
    <f:FactDef> NEWLINE? => Declaration::Fact(f),
    <q:QueryDef> NEWLINE? => Declaration::Query(q),
    <u:UnitDef> NEWLINE? => Declaration::Unit(u),
};

// ============================================================================
// UNIT
// ============================================================================

// A number usable as a unit scale factor: accepts both `2` and `0.92`.
Num: f64 = {
    INT => <> as f64,
    FLOAT => <>,
};

// Keyword is `unitdef`, not `unit` — `unit` is already an established,
// widely-used ordinary identifier (e.g. the `unit.Mass` qualified-name
// convention in docs/src/code/units.dlf), so it can't be reserved without
// breaking that existing usage.
UnitDef: UnitDef = {
    // `unitdef family vegetables`
    <start:@L> "unitdef" "family" <ns:@L> <name:NAME> <ne:@R> <end:@R> NEWLINE => {
        UnitDef { name: SpannedString::new(name, Some(Span { start: ns, end: ne })), kind: UnitKind::Family(), span: Some(Span { start, end }) }
    },
    // `unitdef bunch_of_carrots: nominal of vegetables scale 2`
    <start:@L> "unitdef" <ns:@L> <name:NAME> <ne:@R> ":" "nominal" "of" <family:QualifiedName> "scale" <scale:Num> <end:@R> NEWLINE => {
        UnitDef { name: SpannedString::new(name, Some(Span { start: ns, end: ne })), kind: UnitKind::Nominal { family, scale }, span: Some(Span { start, end }) }
    },
    // `unitdef USD: scale 0.92 EUR`
    <start:@L> "unitdef" <ns:@L> <name:NAME> <ne:@R> ":" "scale" <scale:Num> <reference:NAME> <end:@R> NEWLINE => {
        UnitDef { name: SpannedString::new(name, Some(Span { start: ns, end: ne })), kind: UnitKind::Derived { scale, reference }, span: Some(Span { start, end }) }
    },
};


// ============================================================================
// CONCEPT
// ============================================================================

ConceptDef: ConceptDef = {
    <start:@L> "concept" <ns:@L> <name:NAME> <ne:@R> ":"? NEWLINE
    INDENT
    <end:@R>
    <members:ConceptMember+>
    DEDENT  => {
        let mut parents = Vec::new();
        let mut has_declarations = Vec::new();
        let mut span = Span { start, end };

        let mut one_of: Option<Vec<OneOfVariant>> = None;
        let mut iri_name: Option<IriNameValue> = None;

        for (member, mspan) in members {
            match member {
                ConceptMember::Sub(p) => {
                    span = span.merge(&mspan);
                    parents.extend(p)
                },
                ConceptMember::Has(h) => {
                    span = span.merge(&mspan);
                    has_declarations.push(h)
                },
                ConceptMember::OneOf(variants) => {
                    // Check if at most one section "one of" is present
                    span = span.merge(&mspan);
                    one_of = Some(variants);
                },
                ConceptMember::IriName(val) => {
                    span = span.merge(&mspan);
                    iri_name = Some(val);
                },
            }
        }

        let mut concept = ConceptDef::new(name, parents, has_declarations, one_of, Some(span), Some(Span { start: ns, end: ne }));
        concept.iri_name = iri_name;
        concept
    },
    // Concept without body (just declaration)
    <start:@L> "concept" <ns:@L> <name:NAME> <ne:@R> <end:@R> NEWLINE => ConceptDef::new(name, vec![], vec![], None, Some(Span { start, end }), Some(Span { start: ns, end: ne })),
};

ConceptMember: (ConceptMember, Span) = {
    <s:SubDeclaration> => (ConceptMember::Sub(s.0), s.1),
    <h:HasDeclaration> => (ConceptMember::Has(h.clone()), h.span.unwrap()),
    <oo:OneOfBlock> => (ConceptMember::OneOf(oo.0), oo.1),
    <start:@L> "@iri_name" <iri:IRI> NEWLINE+ <end:@R> => (ConceptMember::IriName(IriNameValue::AbsoluteUri(iri)), Span { start, end }),
};

OneOfBlock: (Vec<OneOfVariant>, Span) = {
    <start:@L> "one of" ":" NEWLINE 
    INDENT <end:@R>
      <variants:OneOfItem+>
    DEDENT => {
      let mut span = Span { start, end };
      for v in &variants {
        if let Some(vspan) = v.span {
          span = span.merge(&vspan);
        }
      }
      (variants, span)
    }
};

OneOfItem: OneOfVariant = {
    <start:@L> <name:NAME> <pre_end:@R> <constraints:NoCmpConstraintBlock?> <end:@R> NEWLINE => {
        if constraints.is_some() {
          OneOfVariant { name, constraints, span: Some(Span { start, end }) }
        } else {
          OneOfVariant { name, constraints, span: Some(Span { start, end: pre_end }) }
        }
    }
};

SubDeclaration: (Vec<TypeRef>, Span) = {
    <start:@L> "sub" <types:Comma<TypeRef>> <end:@R> NEWLINE => (types, Span { start, end }),
};

HasDeclaration: HasDeclaration = {
    <start:@L> "has" <is_key:("key")?> <name:NAME> ":" <cardinality:Optional<Cardinality>> <type_ref:TypeRef> <end:@R> NEWLINE
    INDENT <axioms:PropertyAxiom+> DEDENT => {
        HasDeclaration { name, is_key: is_key.is_some(), cardinality, type_ref, axioms, span: Some(Span { start, end }) }
    },
    <start:@L> "has" <is_key:("key")?> <name:NAME> ":" <cardinality:Optional<Cardinality>> <type_ref:TypeRef> <end:@R> NEWLINE => {
        HasDeclaration { name, is_key: is_key.is_some(), cardinality, type_ref, axioms: vec![], span: Some(Span { start, end }) }
    },
};

// ============================================================================
// PROPERTY
// ============================================================================

PropertyAxiom: PropertyAxiom = {
    <start:@L> "sub" <property:QualifiedName> <end:@R> NEWLINE
        => PropertyAxiom::Sub { property, span: Some(Span { start, end }) },
    <start:@L> "inverse of" <property:QualifiedName> <end:@R> NEWLINE
        => PropertyAxiom::InverseOf { property, span: Some(Span { start, end }) },
    <start:@L> "transitive" <end:@R> NEWLINE
        => PropertyAxiom::Transitive { span: Some(Span { start, end }) },
    <start:@L> "symmetric" <end:@R> NEWLINE
        => PropertyAxiom::Symmetric { span: Some(Span { start, end }) },
    <start:@L> "reflexive" <end:@R> NEWLINE
        => PropertyAxiom::Reflexive { span: Some(Span { start, end }) },
    <start:@L> "equivalent to" <path:PropertyPath> <end:@R> NEWLINE
        => PropertyAxiom::EquivalentTo { path, span: Some(Span { start, end }) },
};

// ============================================================================
// PROPERTY PATH EXPRESSIONS  (for "equivalent to")
// ============================================================================

PropertyPath: PropertyPath = {
    <PropertyPathAlt>
};

PropertyPathAlt: PropertyPath = {
    <start:@L> <l:PropertyPathSeq> "|" <r:PropertyPathAlt> <end:@R>
        => PropertyPath::Alt { left: Box::new(l), right: Box::new(r), span: Some(Span { start, end }) },
    <PropertyPathSeq>,
};

PropertyPathSeq: PropertyPath = {
    <start:@L> <l:PropertyPathSeq> "/" <r:PropertyPathMod> <end:@R> => {
        match l {
            PropertyPath::Sequence { mut steps, .. } => {
                steps.push(r);
                PropertyPath::Sequence { steps, span: Some(Span { start, end }) }
            }
            other => PropertyPath::Sequence { steps: vec![other, r], span: Some(Span { start, end }) },
        }
    },
    <PropertyPathMod>,
};

PropertyPathMod: PropertyPath = {
    <start:@L> <p:PropertyPathAtom> "+" <end:@R>
        => PropertyPath::OneOrMore { inner: Box::new(p), span: Some(Span { start, end }) },
    <start:@L> <p:PropertyPathAtom> "*" <end:@R>
        => PropertyPath::ZeroOrMore { inner: Box::new(p), span: Some(Span { start, end }) },
    <PropertyPathAtom>,
};

PropertyPathAtom: PropertyPath = {
    <start:@L> "^" <p:PropertyPathAtom> <end:@R>
        => PropertyPath::Inverse { inner: Box::new(p), span: Some(Span { start, end }) },
    <start:@L> <n:QualifiedName> <end:@R>
        => PropertyPath::Name { name: n, span: Some(Span { start, end }) },
    "(" <p:PropertyPath> ")" => p,
};

PropertyDef: PropertyDef = {
    <start:@L> "property" <name_start:@L> <name:NAME> <name_end:@R> ":"
        <domain_cardinality:Optional<Cardinality>> <domain:TypeRef>
        "->"
        <range_cardinality:Optional<Cardinality>> <range:TypeRef>
    <end:@R> NEWLINE
    INDENT <axioms:PropertyAxiom+> DEDENT => {
        PropertyDef {
            name: SpannedString::new(name, Some(Span { start: name_start, end: name_end })),
            domain_cardinality,
            domain,
            range_cardinality,
            range,
            axioms,
            span: Some(Span { start, end }),
        }
    },
    <start:@L> "property" <name_start:@L> <name:NAME> <name_end:@R> ":"
        <domain_cardinality:Optional<Cardinality>> <domain:TypeRef>
        "->"
        <range_cardinality:Optional<Cardinality>> <range:TypeRef>
    <end:@R> NEWLINE => {
        PropertyDef {
            name: SpannedString::new(name, Some(Span { start: name_start, end: name_end })),
            domain_cardinality,
            domain,
            range_cardinality,
            range,
            axioms: vec![],
            span: Some(Span { start, end }),
        }
    },
};

// ============================================================================
// QUERY
// ============================================================================

QueryDef: QueryDef = {
    <start:@L> "query" <name_start:@L> <name:NAME> <name_end:@R> ":" NEWLINE
    INDENT <body:QueryBody> DEDENT <end:@R>
    => QueryDef { name, body, span: Some(Span { start, end }), name_span: Some(Span { start: name_start, end: name_end }) }
};

QueryBody: QueryBody = {
    <start:@L> <clauses:QueryClause*> <group_by:GroupByBlock?> <return_block:ReturnBlock?> <end:@R>
    => QueryBody { clauses, group_by, return_block, span: Some(Span { start, end }) }
};

QueryClause: QueryClause = {
    <sp:QSubjectPattern>  => QueryClause::SubjectPattern(sp),
    <eb:QExistenceBlock>  => QueryClause::ExistenceBlock(eb),
    <qc:QComposition>     => QueryClause::Composition(qc),
    <bf:QBoolFilter>      => QueryClause::BooleanFilter(bf),
    <aq:QAggClause>       => QueryClause::AggregationQuery(aq),
    <it:QInverseTriple>   => QueryClause::InverseTriple(it),
};

// Bare inverse triple at body/existence level: `is prop of ?var`
QInverseTriple: InverseTriple = {
    <start:@L> "is" <property:QualifiedName> "of" <obj:Object> NEWLINE <end:@R>
    => InverseTriple { property, object: obj, span: Some(Span { start, end }) }
};

// ── Subject patterns ─────────────────────────────────────────────────────────

QSubjectPattern: SubjectPattern = {
    // named with type + indented block
    <start:@L> <subject:VARIABLE> "a" <type_ref:TypeRef> NEWLINE
    INDENT <properties:QPropertyPattern+> DEDENT <end:@R>
    => SubjectPattern { subject: Some(subject), type_ref: Some(type_ref), properties,
                        span: Some(Span { start, end }) },
    // named with type, no properties (bare type assertion)
    <start:@L> <subject:VARIABLE> "a" <type_ref:TypeRef> NEWLINE <end:@R>
    => SubjectPattern { subject: Some(subject), type_ref: Some(type_ref), properties: vec![],
                        span: Some(Span { start, end }) },

    // anonymous with type + indented block
    <start:@L> "a" <type_ref:TypeRef> NEWLINE
    INDENT <properties:QPropertyPattern+> DEDENT <end:@R>
    => SubjectPattern { subject: None, type_ref: Some(type_ref), properties,
                        span: Some(Span { start, end }) },
    // anonymous with type, no properties
    <start:@L> "a" <type_ref:TypeRef> NEWLINE <end:@R>
    => SubjectPattern { subject: None, type_ref: Some(type_ref), properties: vec![],
                        span: Some(Span { start, end }) },

    // untyped + indented block
    <start:@L> <subject:VARIABLE> NEWLINE
    INDENT <properties:QPropertyPattern+> DEDENT <end:@R>
    => SubjectPattern { subject: Some(subject), type_ref: None, properties,
                        span: Some(Span { start, end }) },

    // inline value property with optional continuation block
    <start:@L> <subject:VARIABLE> <property:QualifiedName> <object:Object> NEWLINE
    INDENT <more:QPropertyPattern+> DEDENT <end:@R>
    => SubjectPattern {
        subject: Some(subject), type_ref: None,
        properties: { let mut p = vec![PropertyPattern::Value { property, object, span: None }]; p.extend(more); p },
        span: Some(Span { start, end }),
    },
    <start:@L> <subject:VARIABLE> <property:QualifiedName> <object:Object> NEWLINE <end:@R>
    => SubjectPattern {
        subject: Some(subject), type_ref: None,
        properties: vec![PropertyPattern::Value { property, object, span: None }],
        span: Some(Span { start, end }),
    },

    // inline constrained property (no continuation — spec has no such example)
    <start:@L> <subject:VARIABLE> <property:QualifiedName> <block:ConstraintBlock> NEWLINE <end:@R>
    => SubjectPattern {
        subject: Some(subject), type_ref: None,
        properties: vec![PropertyPattern::Constrained { property, block, span: None }],
        span: Some(Span { start, end }),
    },

    // inline nested block property
    <start:@L> <subject:VARIABLE> <property:QualifiedName> <block:QSubjectBlock> NEWLINE <end:@R>
    => SubjectPattern {
        subject: Some(subject), type_ref: None,
        properties: vec![PropertyPattern::Nested { property, block, span: None }],
        span: Some(Span { start, end }),
    },

    // inline inverse: ?subject is prop of ?var
    <start:@L> <subject:VARIABLE> "is" <property:QualifiedName> "of" <outer_var:VARIABLE> NEWLINE <end:@R>
    => SubjectPattern {
        subject: Some(subject), type_ref: None,
        properties: vec![PropertyPattern::Inverse { property, outer_var, span: None }],
        span: Some(Span { start, end }),
    },

    // inline inverse nested: ?subject is prop of [constraints]
    <start:@L> <subject:VARIABLE> "is" <property:QualifiedName> "of" <block:ConstraintBlock> NEWLINE <end:@R>
    => SubjectPattern {
        subject: Some(subject), type_ref: None,
        properties: vec![PropertyPattern::InverseNested { property, block, span: None }],
        span: Some(Span { start, end }),
    },
};

// ── Property patterns ────────────────────────────────────────────────────────

QPropertyPattern: PropertyPattern = {
    <start:@L> <property:QualifiedName> <object:Object> NEWLINE <end:@R>
    => PropertyPattern::Value { property, object, span: Some(Span { start, end }) },

    <start:@L> <property:QualifiedName> <block:ConstraintBlock> NEWLINE <end:@R>
    => PropertyPattern::Constrained { property, block, span: Some(Span { start, end }) },

    <start:@L> "optional" <property:QualifiedName> <object:Object> NEWLINE <end:@R>
    => PropertyPattern::Optional { property, object, span: Some(Span { start, end }) },

    <start:@L> "is" <property:QualifiedName> "of" <outer_var:VARIABLE> NEWLINE <end:@R>
    => PropertyPattern::Inverse { property, outer_var, span: Some(Span { start, end }) },

    <start:@L> "is" <property:QualifiedName> "of" <block:ConstraintBlock> NEWLINE <end:@R>
    => PropertyPattern::InverseNested { property, block, span: Some(Span { start, end }) },

    <start:@L> <property:QualifiedName> <block:QSubjectBlock> NEWLINE <end:@R>
    => PropertyPattern::Nested { property, block, span: Some(Span { start, end }) },

    <start:@L> <either_branch:QEitherBranch> <or_branches:QOrBranch+> <end:@R>
    => PropertyPattern::Disjunction { either_branch, or_branches, span: Some(Span { start, end }) },
};

// Multi-line nested subject block: [ NEWLINE INDENT ... DEDENT ]
QSubjectBlock: SubjectBlock = {
    <start:@L> "[" NEWLINE INDENT <properties:QPropertyPattern+> DEDENT "]" <end:@R>
    => SubjectBlock { properties, span: Some(Span { start, end }) }
};

QEitherBranch: DisjBranch = {
    <start:@L> "either" <property:QualifiedName> <block:ConstraintBlock> NEWLINE <end:@R>
    => DisjBranch { property, block, span: Some(Span { start, end }) }
};

QOrBranch: DisjBranch = {
    <start:@L> "or" <property:QualifiedName> <block:ConstraintBlock> NEWLINE <end:@R>
    => DisjBranch { property, block, span: Some(Span { start, end }) }
};

// ── Existence blocks ─────────────────────────────────────────────────────────

QExistenceBlock: ExistenceBlock = {
    <start:@L> "some" ":" NEWLINE INDENT <clauses:QueryClause+> DEDENT <end:@R>
    => ExistenceBlock { negated: false, clauses, span: Some(Span { start, end }) },

    <start:@L> "none" ":" NEWLINE INDENT <clauses:QueryClause+> DEDENT <end:@R>
    => ExistenceBlock { negated: true, clauses, span: Some(Span { start, end }) },
};

// ── Query composition ────────────────────────────────────────────────────────

QComposition: QueryComposition = {
    <start:@L> <query_name:QualifiedName> "as" "[" NEWLINE
    INDENT <bindings:QCompositionPair+> DEDENT "]" NEWLINE? <end:@R>
    => QueryComposition {
        query_name,
        binding: CompositionBinding::Named(bindings),
        span: Some(Span { start, end }),
    },

    <start:@L> <query_name:QualifiedName> "as" <var:VARIABLE> NEWLINE <end:@R>
    => QueryComposition {
        query_name,
        binding: CompositionBinding::Scalar(var),
        span: Some(Span { start, end }),
    },
};

QCompositionPair: (String, String) = {
    <field:NAME> <var:VARIABLE> NEWLINE => (field, var)
};

// ── Boolean filters ───────────────────────────────────────────────────────────

QBoolFilter: BoolExpr = {
    <start:@L> <left:VARIABLE> <op:ComparisonOp> <right:QBoolOperand> NEWLINE <end:@R>
    => BoolExpr { left: BoolOperand::Variable(left), op, right, span: Some(Span { start, end }) }
};

QBoolOperand: BoolOperand = {
    <v:VARIABLE> => BoolOperand::Variable(v),
    <l:Literal>  => BoolOperand::Literal(l),
};

// ── Body-level aggregation sub-query ─────────────────────────────────────────

QAggClause: AggregationQuery = {
    <start:@L> <kind_name:NAME> <input_var:VARIABLE> "as" <result_var:VARIABLE> NEWLINE
    INDENT <sub_clauses:QueryClause+> DEDENT <end:@R>
    =>? {
        let kind = match kind_name.as_str() {
            "count"   => AggKind::Count,
            "average" => AggKind::Average,
            "sum"     => AggKind::Sum,
            "min"     => AggKind::Min,
            "max"     => AggKind::Max,
            other => return Err(lalrpop_util::ParseError::User {
                error: LexerError::new(
                    format!("unknown aggregation '{}'; expected count, average, sum, min, or max", other),
                    start,
                    ErrorCode::UnexpectedToken,
                )
            }),
        };
        Ok(AggregationQuery { kind, input_var, result_var, sub_clauses, span: Some(Span { start, end }) })
    }
};

// ── Group-by block ────────────────────────────────────────────────────────────

GroupByBlock: GroupByBlock = {
    <start:@L> "group by" <var:VARIABLE> NEWLINE
    INDENT <items:GroupByItem+> DEDENT <end:@R>
    => {
        let mut specs = vec![];
        let mut having = vec![];
        for (s, h) in items {
            if let Some(s) = s { specs.push(s); }
            if let Some(h) = h { having.push(h); }
        }
        GroupByBlock { var, specs, having, span: Some(Span { start, end }) }
    }
};

GroupByItem: (Option<AggregationSpec>, Option<BoolExpr>) = {
    <start:@L> <kind_name:NAME> <input_var:VARIABLE> "as" <result_var:VARIABLE> NEWLINE <end:@R>
    =>? {
        let kind = match kind_name.as_str() {
            "count"   => AggKind::Count,
            "average" => AggKind::Average,
            "sum"     => AggKind::Sum,
            "min"     => AggKind::Min,
            "max"     => AggKind::Max,
            other => return Err(lalrpop_util::ParseError::User {
                error: LexerError::new(
                    format!("unknown aggregation '{}'; expected count, average, sum, min, or max", other),
                    start,
                    ErrorCode::UnexpectedToken,
                )
            }),
        };
        Ok((Some(AggregationSpec { kind, input_var, result_var, span: Some(Span { start, end }) }), None))
    },

    <start:@L> <left:VARIABLE> <op:ComparisonOp> <right:QBoolOperand> NEWLINE <end:@R>
    => (None, Some(BoolExpr { left: BoolOperand::Variable(left), op, right, span: Some(Span { start, end }) })),
};

// ── Return block ─────────────────────────────────────────────────────────────

ReturnBlock: ReturnBlock = {
    <start:@L> "return" NEWLINE INDENT <lines:ReturnLine*> DEDENT <end:@R>
    => {
        let mut columns = vec![];
        let mut limit = None;
        for (col, lim) in lines {
            if let Some(c) = col { columns.push(c); }
            if let Some(n) = lim { limit = Some(n); }
        }
        ReturnBlock { columns, limit, span: Some(Span { start, end }) }
    }
};

ReturnLine: (Option<ColumnSpec>, Option<u64>) = {
    // ?var with modifier sub-block
    <start:@L> <var:VARIABLE> NEWLINE INDENT <mods:ColModLine+> DEDENT <end:@R>
    => {
        let mut order = None;
        let mut distinct = false;
        for (o, d) in mods { if let Some(dir) = o { order = Some(dir); } if d { distinct = true; } }
        (Some(ColumnSpec { alias: None, var, order, distinct, span: Some(Span { start, end }) }), None)
    },
    // ?var without modifier
    <start:@L> <var:VARIABLE> NEWLINE <end:@R>
    => (Some(ColumnSpec { alias: None, var, order: None, distinct: false,
                          span: Some(Span { start, end }) }), None),

    // alias ?var with modifier sub-block
    <start:@L> <alias:NAME> <var:VARIABLE> NEWLINE INDENT <mods:ColModLine+> DEDENT <end:@R>
    => {
        let mut order = None;
        let mut distinct = false;
        for (o, d) in mods { if let Some(dir) = o { order = Some(dir); } if d { distinct = true; } }
        (Some(ColumnSpec { alias: Some(alias), var, order, distinct, span: Some(Span { start, end }) }), None)
    },
    // alias ?var without modifier
    <start:@L> <alias:NAME> <var:VARIABLE> NEWLINE <end:@R>
    => (Some(ColumnSpec { alias: Some(alias), var, order: None, distinct: false,
                          span: Some(Span { start, end }) }), None),

    // limit N
    <start:@L> <kw:NAME> <n:INT> NEWLINE <end:@R>
    =>? {
        if kw == "limit" {
            Ok((None, Some(n as u64)))
        } else {
            Err(lalrpop_util::ParseError::User {
                error: LexerError::new(
                    format!("expected 'limit', got '{}'", kw),
                    start,
                    ErrorCode::UnexpectedToken,
                )
            })
        }
    },
};

ColModLine: (Option<OrderDir>, bool) = {
    // order asc / order desc
    <start:@L> <kw1:NAME> <kw2:NAME> NEWLINE <end:@R>
    =>? {
        if kw1 != "order" {
            return Err(lalrpop_util::ParseError::User {
                error: LexerError::new(
                    format!("expected 'order' or 'distinct', got '{}'", kw1),
                    start,
                    ErrorCode::UnexpectedToken,
                )
            });
        }
        match kw2.as_str() {
            "asc"  => Ok((Some(OrderDir::Asc), false)),
            "desc" => Ok((Some(OrderDir::Desc), false)),
            other  => Err(lalrpop_util::ParseError::User {
                error: LexerError::new(
                    format!("expected 'asc' or 'desc', got '{}'", other),
                    start,
                    ErrorCode::UnexpectedToken,
                )
            }),
        }
    },
    // distinct
    <start:@L> <kw:NAME> NEWLINE <end:@R>
    =>? {
        if kw == "distinct" {
            Ok((None, true))
        } else {
            Err(lalrpop_util::ParseError::User {
                error: LexerError::new(
                    format!("expected 'order' or 'distinct', got '{}'", kw),
                    start,
                    ErrorCode::UnexpectedToken,
                )
            })
        }
    },
};

QueryArg: QueryArg = {
    <start:@L> <name:VARIABLE> <end:@R> NEWLINE =>
        QueryArg::Var { name, span: Some(Span { start, end }) },
    <start:@L> <param:VARIABLE> "=" <value:Object> <end:@R> NEWLINE =>
        QueryArg::Binding { param, value, span: Some(Span { start, end }) },
};

// ============================================================================
// RULE
// ============================================================================

RuleDef: RuleDef = {
    <start:@L> "rule" <name:NAME> ":" NEWLINE
    INDENT <match_block:MatchBlock> <then_block:ThenBlock>
    DEDENT <end:@R> => RuleDef { name, match_block, then_block, span: Some(Span { start, end }) }
};

MatchBlock: MatchBlock = {
    <start:@L> "match" ":" NEWLINE
    INDENT
    <patterns:MatchPattern+>
    DEDENT <end:@R> => MatchBlock { patterns, span: Some(Span { start, end }) }
};

ThenBlock: ThenBlock = {
    <start:@L> "then" ":" NEWLINE
    INDENT
    <items:ThenItem+>
    DEDENT <end:@R> => ThenBlock { items, span: Some(Span { start, end }) }
};

MatchPattern: Pattern = {
    <start:@L> <subject:Subject> <property:QualifiedName> <object:Object> <end:@R> NEWLINE =>
        Pattern::Triple { subject, property, object, span: Some(Span { start, end }) },
    <start:@L> <subject:Subject> <property:QualifiedName> <block:ConstraintBlock> <end:@R> NEWLINE =>
        Pattern::Triple { subject, property, object: Object::Constraint { block }, span: Some(Span { start, end }) },
    <start:@L> <subject:Subject> "a" <type_ref:TypeRef> <end:@R> NEWLINE =>
        Pattern::Type { subject, type_ref, span: Some(Span { start, end }) },
    <start:@L> <subject:Subject> "is" <property:QualifiedName> "of" <object:Object> <end:@R> NEWLINE =>
        Pattern::Inverse { subject, property, object, span: Some(Span { start, end }) },
    <start:@L> <subject:Subject> "is" <property:QualifiedName> "of" <block:ConstraintBlock> <end:@R> NEWLINE =>
        Pattern::Inverse { subject, property, object: Object::Constraint { block }, span: Some(Span { start, end }) },
    <start:@L> <quantifier:Quantifier> <variable:VARIABLE> <constraint:Optional<ConstraintBlock>> ":"
        NEWLINE INDENT <patterns:MatchPattern+> DEDENT <end:@R> => {
        Pattern::Quantified {
            quantifier,
            variable,
            constraint,
            patterns,
            span: Some(Span { start, end }),
        }
    },
    <start:@L> <name:QualifiedName> NEWLINE
        INDENT <args:QueryArg+> DEDENT <end:@R> =>
        Pattern::QueryCall { name, args, span: Some(Span { start, end }) },
};

Quantifier: Quantifier = {
    <start:@L> "all" <end:@R> => Quantifier::All { span: Some(Span { start, end })},
    <start:@L> "none" <end:@R> => Quantifier::None { span: Some(Span { start, end })},
    <start:@L> "at_least" <value:CardinalityValue> <end:@R> => Quantifier::AtLeast { value, span: Some(Span { start, end }) },
    <start:@L> "at_most" <value:CardinalityValue> <end:@R> => Quantifier::AtMost { value, span: Some(Span { start, end }) },
    <start:@L> "exactly" <value:CardinalityValue> <end:@R> => Quantifier::Exactly { value, span: Some(Span { start, end }) },
    <start:@L> "between" <min:CardinalityValue> "," <max:CardinalityValue> <end:@R> => Quantifier::Between { min, max, span: Some(Span { start, end }) },
};

ThenItem: ThenItem = {
    <Assertion> NEWLINE => <>,
    <NestedRule> => ThenItem::NestedRule { rule: <> },
};

Assertion: ThenItem = {
    <start:@L> <subject:Subject> <property:QualifiedName> <object:Object> <end:@R> =>
        ThenItem::AssertionTriple { 
            assertion: Assertion { 
                subject, 
                property, 
                object,
                span: Some(Span { start, end }),
            },
            span: Some(Span { start, end }),
        },
    <start:@L> <subject:Subject> <property:QualifiedName> <block:NoCmpConstraintBlock> <end:@R> =>
        ThenItem::AssertionTriple { 
            assertion: Assertion { 
                subject, 
                property, 
                object: Object::Constraint { block },
                span: Some(Span { start, end }),
            },
            span: Some(Span { start, end }),
        },
    <start:@L> <subject:Subject> "a" <l:@L> <type_ref:TypeRef> <r:@R> <end:@R> =>?
        match type_ref {
            TypeRef::Named { name: typing, .. } => Ok(ThenItem::AssertionTyping { 
                subject, 
                typing,
                span: Some(Span { start, end }),
            }),
            TypeRef::Primitive { kind, .. } => Err(lalrpop_util::ParseError::UnrecognizedToken {
                token: (l, Token::Name(kind.to_string()), r),
                expected: vec![
                    "Qualified name that is not a primitive".to_string(),
                ],
            }),
        },
};

NestedRule: RuleDef = {
    <start:@L> <match_block:MatchBlock> <then_block:ThenBlock> <end:@R> => {
        RuleDef {
            name: "anonymous".to_string(),
            match_block,
            then_block,
            span: Some(Span { start, end }),
        }
    }
};

// ============================================================================
// FACT (INSTANCE DECLARATIONS)
// ============================================================================

/// A top-level fact: `fact <id> a <Type>, ...`
FactDef: FactDef = {
    // fact with body
    <start:@L> "fact" <id_start:@L> <id:NAME> <id_end:@R> "a" <types:Comma<QualifiedName>> NEWLINE
    INDENT <assertions:FactAssertion+> DEDENT <end:@R>
    => FactDef { id, types, assertions, span: Some(Span { start, end }), id_span: Some(Span { start: id_start, end: id_end }) },

    // fact without body (bare declaration)
    <start:@L> "fact" <id_start:@L> <id:NAME> <id_end:@R> "a" <types:Comma<QualifiedName>> <end:@R> NEWLINE
    => FactDef { id, types, assertions: vec![], span: Some(Span { start, end }), id_span: Some(Span { start: id_start, end: id_end }) },
};

/// One assertion line within a fact body
FactAssertion: FactAssertion = {
    // property_name value, value, ...
    <start:@L> <property:QualifiedName> <values:Comma<FactValue>> <end:@R> NEWLINE
    => FactAssertion::Property { property, values, span: Some(Span { start, end }) },

    // is <property> of <value>
    <start:@L> "is" <property:QualifiedName> "of" <value:FactValue> <end:@R> NEWLINE
    => FactAssertion::Inverse { property, value, span: Some(Span { start, end }) },

    // a <ConceptName>  (type hint inside anonymous block)
    <start:@L> "a" <type_ref:QualifiedName> <end:@R> NEWLINE
    => FactAssertion::TypeHint { type_ref, span: Some(Span { start, end }) },
};

/// A value that can appear on the right-hand side of a property assertion
FactValue: FactValue = {
    // Literal scalar
    <start:@L> <l:Literal> <end:@R>
    => FactValue::Literal { value: l, span: Some(Span { start, end }) },

    // :name  (local reference, empty prefix)
    <start:@L> ":" <name:NAME> <end:@R>
    => FactValue::Reference { qualifier: None, name, span: Some(Span { start, end }) },

    // prefix:name  (prefixed reference)
    <start:@L> <prefix:NAME> ":" <name:NAME> <end:@R>
    => FactValue::Reference { qualifier: Some(prefix), name, span: Some(Span { start, end }) },

    // Multi-line anonymous block: prop [ \n INDENT assertions DEDENT ]
    <start:@L> "[" NEWLINE INDENT <assertions:FactAssertion+> DEDENT "]" <end:@R>
    => FactValue::Block { type_hint: None, assertions, span: Some(Span { start, end }) },

    // Qualified name (enum value / concept reference)  — must come last to avoid
    // eating :name or prefix:name prefixes
    <start:@L> <name:QualifiedName> <end:@R>
    => FactValue::Named { name, span: Some(Span { start, end }) },
};

// ============================================================================
// SUBJECTS AND OBJECTS
// ============================================================================

Subject: Subject = {
    <start:@L> <v:VARIABLE> <end:@R> => Subject::Variable { name: v, span: Some(Span { start, end }) },
    <start:@L> <n:QualifiedName> <end:@R> => Subject::Constant { name: n, span: Some(Span { start, end }) },
    <start:@L> <b:ConstraintBlock> <end:@R> => Subject::Constraint { block: b, span: Some(Span { start, end }) },
};

Object: Object = {
    // A bare variable and a variable-operand math expression both flow through
    // `Expr` (see `PrimaryExpr`). Collapse a lone `Expr::Variable` back to
    // `Object::Variable` so downstream consumers keep the same AST shape; any
    // compound expression stays an `Object::Literal`.
    <start:@L> <v:Expr> <end:@R> => match v {
        Expr::Variable { name, span } => Object::Variable { name, span },
        _ => Object::Literal { value: v, span: Some(Span { start, end }) },
    },
    <start:@L> <n:QualifiedName> <end:@R> => Object::Constant { value: n, span: Some(Span { start, end }) },
};

// ============================================================================
// CONSTRAINTS
// ============================================================================

NoCmpConstraintBlock: ConstraintBlock = {
    <start:@L> "[" <constraints:Comma<NoCmpConstraint>> "]" <end:@R> => ConstraintBlock { constraints, span: Some(Span { start, end }) }
};

NoCmpConstraint: Constraint = {
    <start:@L> "a" <type_ref:TypeRef> <end:@R> => Constraint::TypeIs { type_ref, span: Some(Span { start, end }) },
    <start:@L> <property:QualifiedName> <value:Object> <end:@R> => Constraint::PropertyValue { property, value, span: Some(Span { start, end }) },
    <start:@L> <property:QualifiedName> <block:NoCmpConstraintBlock> <end:@R> => {
        Constraint::PropertyConstraint { property, block, span: Some(Span { start, end }) }
    },
};
 
ConstraintBlock: ConstraintBlock = {
    <start:@L> "[" <constraints:Comma<Constraint>> "]" <end:@R> => ConstraintBlock { constraints, span: Some(Span { start, end }) }
};

Constraint: Constraint = {
    <start:@L> "a" <type_ref:TypeRef> <end:@R>
        => Constraint::TypeIs { type_ref, span: Some(Span { start, end }) },
    <start:@L> <op:ComparisonOp> <value:Expr> <end:@R>
        => Constraint::Comparison { binding: None, operator: op, value, span: Some(Span { start, end }) },
    <start:@L> <binding:VARIABLE> <op:ComparisonOp> <value:Expr> <end:@R>
        => Constraint::Comparison { binding: Some(binding), operator: op, value, span: Some(Span { start, end }) },
    <start:@L> <property:QualifiedName> <value:Object> <end:@R>
        => Constraint::PropertyValue { property, value, span: Some(Span { start, end }) },
    <start:@L> <property:QualifiedName> <block:ConstraintBlock> <end:@R>
        => Constraint::PropertyConstraint { property, block, span: Some(Span { start, end }) },
    <start:@L> "is" <property:QualifiedName> "of" <value:Object> <end:@R>
        => Constraint::Inverse { property, value, span: Some(Span { start, end }) },
    <start:@L> "is" <property:QualifiedName> "of" <block:ConstraintBlock> <end:@R>
        => Constraint::InverseNested { property, block, span: Some(Span { start, end }) },
};

ComparisonOp: ComparisonOp = {
    "=" => ComparisonOp::Equal,
    "!=" => ComparisonOp::NotEqual,
    "<" => ComparisonOp::LessThan,
    "<=" => ComparisonOp::LessEqual,
    ">" => ComparisonOp::GreaterThan,
    ">=" => ComparisonOp::GreaterEqual,
};

// ============================================================================
// TYPES
// ============================================================================

TypeRef: TypeRef = {
    <start:@L> <n:QualifiedName> <end:@R> => TypeRef::Named { name: n, span: Some(Span { start, end }) },
    <PrimitiveType> => <>,
};

PrimitiveType: TypeRef = {
    <start:@L> "string" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::String, span: Some(Span { start, end }) },
    <start:@L> "int" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::Int, span: Some(Span { start, end }) },
    <start:@L> "float" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::Float, span: Some(Span { start, end }) },
    <start:@L> "boolean" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::Boolean, span: Some(Span { start, end }) },
    <start:@L> "date" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::Date, span: Some(Span { start, end }) },
    <start:@L> "date_time" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::DateTime, span: Some(Span { start, end }) },
    <start:@L> "time" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::Time, span: Some(Span { start, end }) },
    <start:@L> "duration" <end:@R> => TypeRef::Primitive { kind: PrimitiveKind::Duration, span: Some(Span { start, end }) },
};

QualifiedName: QualifiedName = {
    <start:@L> <first:NAME> <rest:("." <NAME>)*> <end:@R> => {
        let mut parts = vec![first];
        parts.extend(rest);
        QualifiedName::new(parts, Some(Span { start, end }))
    },
    <start:@L> <pn:PREFIXED_NAME> <end:@R> => {
        QualifiedName::new_prefixed(pn.0, pn.1, Some(Span { start, end }))
    },
};

QualifiedNameOrIRI: QualifiedName = {
    <QualifiedName> => <>,
    <start:@L> <iri:IRI> <end:@R> => QualifiedName {
        parts: vec![iri],
        is_prefixed: false,
        span: Some(Span { start, end }),
    }
};


// ============================================================================
// CARDINALITY
// ============================================================================

Cardinality: Cardinality = {
    <start:@L> "one" <end:@R> => Cardinality::One { span: Some(Span { start, end })},
    <start:@L> "any" <end:@R> => Cardinality::Any { span: Some(Span { start, end })},
    <start:@L> "some" <end:@R> => Cardinality::Some { span: Some(Span { start, end })},
    <start:@L> "optional" <end:@R> => Cardinality::Optional { span: Some(Span { start, end })},
    <start:@L> <n:INT> <end:@R> => Cardinality::Exact { value: n as usize, span: Some(Span { start, end }) },
    <start:@L> <min:INT> ".." <max:INT> <end:@R> => Cardinality::Range { 
        min: min as usize, 
        max: Some(max as usize),
        span: Some(Span { start, end }),
    },
    <start:@L> <min:INT> ".." "*" <end:@R> => Cardinality::Range {
        min: min as usize,
        max: None,
        span: Some(Span { start, end }),
    },
    <start:@L> "at_least" <n:INT> <end:@R> => Cardinality::Range {
        min: n as usize,
        max: None,
        span: Some(Span { start, end }),
    },
    <start:@L> "at_most" <n:INT> <end:@R> => Cardinality::Range {
        min: 0,
        max: Some(n as usize),
        span: Some(Span { start, end }),
    },
};

CardinalityValue: CardinalityValue = {
    <start:@L> <n:INT> <end:@R> => CardinalityValue::Int { value: n as usize, span: Some(Span { start, end }) },
    <start:@L> <v:VARIABLE> <end:@R> => CardinalityValue::Variable { name: v, span: Some(Span { start, end }) },
};

// ============================================================================
// LITERALS
// ============================================================================

Literal: Literal = {
    <start:@L> <n:INT> <end:@R> => Literal::Int { value: n, span: Some(Span { start, end })},
    <start:@L> <n:FLOAT> <end:@R> => Literal::Float { value: n, span: Some(Span { start, end })},
    <start:@L> <s:STRING> <end:@R> => Literal::String { value: s, span: Some(Span { start, end })},
    <start:@L> <b:BOOLEAN> <end:@R> => Literal::Boolean { value: b, span: Some(Span { start, end })},
    <start:@L> <i:IRI> <end:@R> => Literal::Iri { value: i, span: Some(Span { start, end })},
    <start:@L> <t:TEMPORAL_LIT> <end:@R> => Literal::Temporal { kind: t.0, content: t.1, span: Some(Span { start, end })},
    <start:@L> <c:QUANTITY_LIT> <end:@R> => Literal::Quantity { content: c, span: Some(Span { start, end })},
};

// ============================================================================
// EXPRESSIONS
// ============================================================================

Expr: Expr = {
    <AddExpr> => <>,
};

AddExpr: Expr = {
    <start:@L> <left:AddExpr> "+" <right:MulExpr> <end:@R> => Expr::BinaryOp {
        op: BinaryOp::Add,
        left: Box::new(left),
        right: Box::new(right),
        span: Some(Span { start, end }),
    },
    <start:@L> <left:AddExpr> "-" <right:MulExpr> <end:@R> => Expr::BinaryOp {
        op: BinaryOp::Sub,
        left: Box::new(left),
        right: Box::new(right),
        span: Some(Span { start, end }),
    },
    <MulExpr> => <>,
};

MulExpr: Expr = {
    <start:@L> <left:MulExpr> "*" <right:UnaryExpr> <end:@R> => Expr::BinaryOp {
        op: BinaryOp::Mul,
        left: Box::new(left),
        right: Box::new(right),
        span: Some(Span { start, end }),
    },
    <start:@L> <left:MulExpr> "/" <right:UnaryExpr> <end:@R> => Expr::BinaryOp {
        op: BinaryOp::Div,
        left: Box::new(left),
        right: Box::new(right),
        span: Some(Span { start, end }),
    },
    <UnaryExpr> => <>,
};

UnaryExpr: Expr = {
    <start:@L> "-" <operand:UnaryExpr> <end:@R> => Expr::UnaryOp {
        op: UnaryOp::Neg,
        operand: Box::new(operand),
        span: Some(Span { start, end }),
    },
    <PrimaryExpr> => <>,
};

PrimaryExpr: Expr = {
    <start:@L> "(" <e:Expr> ")" <end:@R> => e,
    <start:@L> <v:VARIABLE> <end:@R> => Expr::Variable {
        name: v,
        span: Some(Span { start, end }),
    },
    <start:@L> <n:INT> <end:@R> => Expr::Literal {
        value: Literal::Int { value: n, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
    <start:@L> <n:FLOAT> <end:@R> => Expr::Literal {
        value: Literal::Float { value: n, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
    <start:@L> <s:STRING> <end:@R> => Expr::Literal {
        value: Literal::String { value: s, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
    <start:@L> <b:BOOLEAN> <end:@R> => Expr::Literal {
        value: Literal::Boolean { value: b, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
    <start:@L> <i:IRI> <end:@R> => Expr::Literal {
        value: Literal::Iri { value: i, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
    <start:@L> <t:TEMPORAL_LIT> <end:@R> => Expr::Literal {
        value: Literal::Temporal { kind: t.0, content: t.1, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
    <start:@L> <c:QUANTITY_LIT> <end:@R> => Expr::Literal {
        value: Literal::Quantity { content: c, span: Some(Span { start, end }) },
        span: Some(Span { start, end }),
    },
};
